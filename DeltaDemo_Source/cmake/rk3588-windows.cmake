set(CMAKE_SYSTEM_NAME Linux)
set(CMAKE_SYSTEM_PROCESSOR aarch64)
set(CMAKE_POSITION_INDEPENDENT_CODE ON)
get_filename_component(DEMO_SOURCE "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)
set(DEMO_CROSS_ROOT "${DEMO_SOURCE}/../DeltaDemo_BuildTools" CACHE PATH "Local cross-build dependencies")
set(DEMO_GNU_ROOT "${DEMO_CROSS_ROOT}/gnu13" CACHE PATH "Arm GNU Windows compiler")
set(CMAKE_C_COMPILER "${DEMO_GNU_ROOT}/bin/aarch64-none-linux-gnu-gcc.exe")
set(CMAKE_CXX_COMPILER "${DEMO_GNU_ROOT}/bin/aarch64-none-linux-gnu-g++.exe")
set(CMAKE_SYSROOT "${DEMO_CROSS_ROOT}/sysroot")
set(CMAKE_CXX_FLAGS_INIT "-B${CMAKE_SYSROOT}/usr/lib/aarch64-linux-gnu/ -isystem ${CMAKE_SYSROOT}/usr/include/aarch64-linux-gnu")
set(CMAKE_FIND_ROOT_PATH "${CMAKE_SYSROOT}")
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)
set(CMAKE_EXE_LINKER_FLAGS_INIT "-L${CMAKE_SYSROOT}/usr/lib/aarch64-linux-gnu -Wl,-rpath-link,${CMAKE_SYSROOT}/lib/aarch64-linux-gnu -Wl,-rpath-link,${CMAKE_SYSROOT}/usr/lib/aarch64-linux-gnu")
set(DEMO_CROSS_QT ON CACHE BOOL "Use board Qt libraries and Windows Qt code generators")
